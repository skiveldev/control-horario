rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // REGLAS DE PRODUCCIÓN - MVP Sprint 1.4
    // ========================================
    
    // Helper global: Verificar si el usuario tiene rol admin o rrhh
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'rrhh'];
    }
    
    // Colección de usuarios
    match /users/{userId} {
      // Los usuarios pueden leer su propio documento
      // Admin y RRHH pueden leer todos los documentos
      allow read: if request.auth != null && 
                  (request.auth.uid == userId || isAdmin());
      
      // Solo admin y RRHH pueden crear usuarios (Sprint 1.4)
      // WORKAROUND: Permitir que usuario cree su propio documento (para creación desde cliente)
      // TODO [POST-MVP]: Mover a Cloud Function para mayor seguridad
      allow create: if isAdmin() || 
                    (request.auth != null && request.auth.uid == userId);
      
      // Solo admin y RRHH pueden actualizar usuarios (Sprint 1.4)
      allow update: if isAdmin();
      
      // No permitir eliminar usuarios (seguridad)
      allow delete: if false;
      
      // Subcolección de registros diarios
      match /daily_records/{recordId} {
        // Los usuarios solo pueden leer sus propios registros
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Los usuarios pueden crear nuevos registros
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId;
        
        // Los usuarios pueden actualizar sus propios registros
        // (solo para agregar hora de salida)
        allow update: if request.auth != null 
                      && request.auth.uid == userId
                      && resource.data.userId == userId;
        
        // No permitir eliminar registros
        allow delete: if false;
      }
      
      // Subcolección de registros de tiempo (Mi Control Horario)
      match /time_records/{recordId} {
        // Helper: Verificar si el usuario tiene rol admin
        function isAdmin() {
          return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
        
        // Helper: Verificar si el registro está bloqueado
        function isBlocked() {
          return resource.data.validationStatus == 'blocked';
        }
        
        // Los usuarios pueden leer sus propios registros
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Los usuarios pueden crear nuevos registros
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.validationStatus == 'editable';
        
        // Los usuarios pueden actualizar sus registros si no están bloqueados
        allow update: if request.auth != null 
                      && request.auth.uid == userId
                      && resource.data.userId == userId
                      && !isBlocked()
                      // Solo admin puede cambiar validationStatus a blocked
                      && (request.resource.data.validationStatus != 'blocked' || isAdmin());
        
        // Los usuarios pueden eliminar sus registros si no están bloqueados
        allow delete: if request.auth != null 
                      && request.auth.uid == userId
                      && resource.data.userId == userId
                      && !isBlocked();
      }
    }
    
    // Denegar acceso a cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



