#!/bin/bash

# ============================================================================
# Pre-commit Hook - Control Horario
# ============================================================================
# Este script se ejecuta automáticamente antes de cada commit
# Verifica calidad del código y previene commits con errores
# ============================================================================

echo "🔍 Ejecutando verificaciones pre-commit..."

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ============================================================================
# 1. VERIFICAR QUE FLUTTER ESTÉ DISPONIBLE
# ============================================================================
if ! command -v flutter &> /dev/null; then
    echo -e "${RED}❌ Flutter no está instalado o no está en el PATH${NC}"
    exit 1
fi

echo "✓ Flutter detectado"

# ============================================================================
# 2. FORMATEAR CÓDIGO (Auto-fix)
# ============================================================================
echo ""
echo "📝 Formateando código Dart..."
dart format lib/ --set-exit-if-changed

if [ $? -ne 0 ]; then
    echo -e "${YELLOW}⚠️  Archivos formateados automáticamente${NC}"
    echo -e "${YELLOW}   Agrégalos al stage: git add .${NC}"
    exit 1
fi

echo "✓ Formato correcto"

# ============================================================================
# 3. ANALIZAR CÓDIGO (Linter)
# ============================================================================
echo ""
echo "🔎 Analizando código con linter..."
flutter analyze --fatal-infos

if [ $? -ne 0 ]; then
    echo ""
    echo -e "${RED}❌ Errores de linter detectados${NC}"
    echo -e "${RED}   Corrige los errores antes de hacer commit${NC}"
    echo ""
    echo "   Comandos útiles:"
    echo "   - Ver errores: flutter analyze"
    echo "   - Formatear: flutter format lib/"
    echo ""
    exit 1
fi

echo "✓ Análisis pasado sin errores"

# ============================================================================
# 4. VERIFICAR IMPORTS NO USADOS
# ============================================================================
echo ""
echo "📦 Verificando imports..."
# Esta verificación está incluida en flutter analyze
echo "✓ Imports verificados"

# ============================================================================
# 5. VERIFICAR ARCHIVOS GENERADOS (opcional)
# ============================================================================
echo ""
echo "🔨 Verificando archivos generados..."

# Verificar si hay archivos .g.dart desactualizados
NEEDS_BUILD=$(find lib -name "*.dart" -newer lib -name "*.g.dart" 2>/dev/null | wc -l)

if [ $NEEDS_BUILD -gt 0 ]; then
    echo -e "${YELLOW}⚠️  Posibles archivos generados desactualizados${NC}"
    echo -e "${YELLOW}   Considera ejecutar: flutter pub run build_runner build${NC}"
fi

echo "✓ Archivos generados OK"

# ============================================================================
# TODO CORRECTO - PERMITIR COMMIT
# ============================================================================
echo ""
echo -e "${GREEN}✅ Todas las verificaciones pasaron correctamente${NC}"
echo -e "${GREEN}   Procediendo con el commit...${NC}"
echo ""

exit 0

