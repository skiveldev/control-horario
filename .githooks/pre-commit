#!/bin/bash

# On Windows, delegate to the native .bat to avoid mintty windows
if [ "$OSTYPE" = "msys" ] || [ "$OSTYPE" = "cygwin" ]; then
  cmd.exe //c ".githooks\\pre-commit.bat"
  exit $?
fi

# ============================================================================
# Pre-commit Hook - Control Horario
# ============================================================================
# Verifies staged Dart formatting (check-only, no mutation) and runs the
# static analyzer.  Cancels the commit if either check fails.
# ============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# 1. Check-only staged Dart formatting (no mutation)
# ---------------------------------------------------------------------------
echo ""
echo "📝 Checking staged Dart formatting..."

dart run tool/check_staged_dart_format.dart
FMT_EXIT=$?

if [ $FMT_EXIT -ne 0 ]; then
  echo ""
  echo -e "${RED}❌ Staged Dart formatting check failed.${NC}"
  echo -e "${RED}   Format the files listed above, stage them, and try again.${NC}"
  exit $FMT_EXIT
fi

echo -e "${GREEN}✓ Staged formatting OK${NC}"

# ---------------------------------------------------------------------------
# 2. Static analysis (full project, check-only)
# ---------------------------------------------------------------------------
echo ""
echo "🔎 Running static analysis..."

flutter analyze --no-pub --fatal-infos --fatal-warnings

if [ $? -ne 0 ]; then
  echo ""
  echo -e "${RED}❌ Static analysis failed.${NC}"
  echo -e "${RED}   Fix the issues above before committing.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ Analysis passed${NC}"

# ---------------------------------------------------------------------------
# All checks passed
# ---------------------------------------------------------------------------
echo ""
echo -e "${GREEN}✅ All pre-commit checks passed.${NC}"
exit 0
